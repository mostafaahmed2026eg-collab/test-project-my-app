<Window x:Class="WallpaperChanger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="WallpaperChanger" Height="680" Width="980"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A24"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FlowDirection="RightToLeft"
        PreviewMouseDown="Window_PreviewMouseDown"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <!-- ============ النصوص الديناميكية ============ -->
        <sys:String x:Key="StrSize">الحجم:</sys:String>
        <sys:String x:Key="StrChange">تغيير</sys:String>
        <sys:String x:Key="StrOpenFolder">فتح الموقع</sys:String>
        <sys:String x:Key="StrSetNowImage">تعيين الصورة</sys:String>
        <sys:String x:Key="StrSetNowVideo">تعيين الفيديو</sys:String>

        <!-- ============ ألوان الثيم ============ -->
        <SolidColorBrush x:Key="MainTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#A8A8B8"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#242432"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#323246"/>
        <SolidColorBrush x:Key="HeaderBgBrush" Color="#242432"/>
        <SolidColorBrush x:Key="ButtonBgBrush" Color="#2E2E40"/>
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#42425A"/>
        <SolidColorBrush x:Key="ButtonHoverBgBrush" Color="#3E3E56"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ============ ستايلات عامة ============ -->
        <Style TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimerRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{DynamicResource ButtonHoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{DynamicResource ButtonBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,5,0"/>
                                    <Path Grid.Column="1" Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource MainTextBrush}" StrokeThickness="1.5" VerticalAlignment="Center" Margin="6,0,2,0"/>
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="toggleButton" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Opacity="0"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Margin="0,3,0,0" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{DynamicResource ButtonHoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{DynamicResource ButtonHoverBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="15" Height="15" Margin="0,0,8,0" FlowDirection="LeftToRight" Cursor="Hand">
                                <Border x:Name="chkBorder" Background="Transparent" BorderBrush="{DynamicResource MainTextBrush}" BorderThickness="1.2" CornerRadius="3"/>
                                <Path x:Name="chkMark" Data="M 2,6 L 5,9 L 11,2" Stroke="{DynamicResource MainTextBrush}" StrokeThickness="1.8" Stretch="Uniform" Width="9" Height="8" Visibility="Collapsed" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="chkBorder" Property="Background" Value="{DynamicResource ButtonHoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chkBorder" Property="BorderBrush" Value="#808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- زر واحد بدل HeaderButtonStyle + CardButtonStyle المكررين -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{DynamicResource ButtonHoverBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- استخدم التعريف التالي مباشرة: -->
        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{DynamicResource ButtonHoverBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" BorderThickness="0,0,0,3" BorderBrush="Transparent" Margin="15,0,15,8" Padding="10,4" Cursor="Hand">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource MainTextBrush}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource MainTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource SubTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- خانة تعديل الاسم (كانت مكررة مرتين). التعديل بيتحفظ لما تخرج من الخانة أو تضغط Enter -->
        <Style x:Key="InlineNameTextBox" TargetType="TextBox">
            <EventSetter Event="KeyDown" Handler="NameBox_KeyDown"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource MainTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MaxWidth" Value="210"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4,0,0,4" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBgBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CursorInfoText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel/>
        </ItemsPanelTemplate>

        <!-- أيقونة مؤشر واحدة (كانت مكررة في الكارتين) -->
        <DataTemplate x:Key="CursorItemTemplate">
            <Border Width="45" Height="45" Margin="4" CornerRadius="6" Background="{DynamicResource ButtonBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" ToolTip="{Binding Name}">
                <Image Source="{Binding IconPath}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </DataTemplate>

        <!-- ============ قالب واحد للصور والفيديوهات (بدل قالبين متطابقين) ============ -->
        <DataTemplate x:Key="MediaListItemTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="{Binding Index}" Foreground="{DynamicResource MainTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center" Width="28"/>
                <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource CardBgBrush}" Width="820" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="124"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="105"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="✖" FontSize="12" FontWeight="Bold" Background="Transparent" Foreground="#FF5252" BorderThickness="0" Cursor="Hand" Click="BtnDelete_Click" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                        <Border Grid.Column="2" Height="64" Width="112" CornerRadius="8" BorderThickness="1" HorizontalAlignment="Center"
                                Background="{DynamicResource ButtonBgBrush}"
                                MouseEnter="Thumb_MouseEnter" MouseLeave="Thumb_MouseLeave">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource MainTextBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.Clip>
                                    <RectangleGeometry Rect="0,0,110,62" RadiusX="7" RadiusY="7"/>
                                </Grid.Clip>
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                <Border Background="#70000000" CornerRadius="12" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="▶" Foreground="#FFFFFF" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0"/>
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="10,0,15,0">
                            <StackPanel HorizontalAlignment="Right" Margin="0,0,0,4" Orientation="Horizontal" FlowDirection="LeftToRight" ToolTip="اضغط لتعديل الاسم (Enter للحفظ)">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <Border BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource CardBgBrush}">
                                    <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                                        <TextBox Style="{StaticResource InlineNameTextBox}" Text="{Binding FileNameOnly, UpdateSourceTrigger=LostFocus}"/>
                                        <Border Width="1" Background="{DynamicResource ButtonBorderBrush}"/>
                                        <Border Background="{DynamicResource ButtonBgBrush}" CornerRadius="0,4,4,0" Padding="6,3">
                                            <TextBlock Text="{Binding FileExtension}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding FilePath}" Foreground="{DynamicResource SubTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" Margin="0,2" ToolTip="{Binding FilePath}"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                <TextBlock Text="{DynamicResource StrSize}" Foreground="{DynamicResource SubTextBrush}" FontSize="11"/>
                                <TextBlock Text="{Binding FileSize}" Foreground="{DynamicResource MainTextBrush}" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="4" Width="90" Height="32" Click="BtnOpenFolder_Click" Style="{StaticResource CardButtonStyle}" Margin="0,0,5,0" ToolTip="فتح موقع الملف في المستكشف">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8DA;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource MainTextBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{DynamicResource StrOpenFolder}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="5" Width="55" Height="32" Click="BtnChange_Click" Style="{StaticResource CardButtonStyle}" Margin="0,0,5,0">
                            <TextBlock Text="{DynamicResource StrChange}" FontSize="12" FontWeight="SemiBold"/>
                        </Button>

                        <Button Grid.Column="6" Width="98" Height="32" Click="BtnSetNow_Click" Style="{StaticResource CardButtonStyle}">
                            <TextBlock FontSize="12" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{DynamicResource StrSetNowImage}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                                <Setter Property="Text" Value="{DynamicResource StrSetNowVideo}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="MediaListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ItemTemplate" Value="{StaticResource MediaListItemTemplate}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ الهيدر العلوي ============ -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBgBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnSettings" Grid.Column="0" Style="{StaticResource HeaderButtonStyle}" Click="BtnSettings_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="txtSettingsIcon" Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource MainTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="settingsRotateTransform" Angle="0"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="txtBtnSettings" Text="إعدادات" Foreground="{DynamicResource MainTextBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="lblChangeEvery" Text="تغيير كل:" Foreground="{DynamicResource SubTextBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1" CornerRadius="5" Background="Transparent" Height="30">
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                            <RepeatButton Width="28" Style="{StaticResource TimerRepeatButtonStyle}" Click="BtnDecreaseTimer_Click" ToolTip="تقليل الوقت">
                                <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource MainTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </RepeatButton>
                            <TextBox x:Name="txtTimer" Width="36" Text="10" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" VerticalContentAlignment="Center" Background="Transparent" Foreground="{DynamicResource MainTextBrush}" CaretBrush="{DynamicResource MainTextBrush}" BorderThickness="0" TextChanged="TxtTimer_TextChanged"/>
                            <RepeatButton Width="28" Style="{StaticResource TimerRepeatButtonStyle}" Click="BtnIncreaseTimer_Click" ToolTip="زيادة الوقت">
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource MainTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </RepeatButton>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="lblMinutes" Text="دقيقة" Foreground="{DynamicResource SubTextBrush}" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <ToggleButton x:Name="btnToggleSearch" Width="32" Height="32" Cursor="Hand" ToolTip="بحث">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bdr" Background="{DynamicResource ButtonBgBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1" CornerRadius="6">
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13" Foreground="{DynamicResource MainTextBrush}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bdr" Property="Background" Value="{DynamicResource CardBgBrush}"/>
                                            <Setter TargetName="bdr" Property="BorderBrush" Value="{DynamicResource MainTextBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bdr" Property="Background" Value="{DynamicResource ButtonHoverBgBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ToggleButton.Triggers>
                                <EventTrigger RoutedEvent="ToggleButton.Checked">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SearchBorder" Storyboard.TargetProperty="Width" To="160" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="SearchBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SearchBorder" Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="SearchBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </ToggleButton.Triggers>
                        </ToggleButton>

                        <Border x:Name="SearchBorder" Width="0" Opacity="0" ClipToBounds="True" BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource ButtonBgBrush}" Margin="6,0,0,0" Height="32">
                            <Grid Width="150" HorizontalAlignment="Left">
                                <TextBox x:Name="txtSearch" VerticalContentAlignment="Center" Padding="8,0,8,0" FontSize="13" Background="Transparent" Foreground="{DynamicResource MainTextBrush}" CaretBrush="{DynamicResource MainTextBrush}" BorderThickness="0" TextChanged="TxtSearch_TextChanged">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <ScrollViewer x:Name="PART_ContentHost"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,8,0" Foreground="{DynamicResource SubTextBrush}">
                                    <Run Text="بحث... "/>
                                    <Run Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Button Width="95" Height="32" Click="BtnSelectFolder_Click" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource MainTextBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtAdd" Text="إضافة" Foreground="{DynamicResource MainTextBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Width="130" Height="32" Click="BtnRefresh_Click" Style="{StaticResource HeaderButtonStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="txtRefreshIcon" Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource MainTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="refreshRotateTransform" Angle="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock x:Name="txtChangeNow" Text="تغيير الخلفية" Foreground="{DynamicResource MainTextBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- النافذة المنبثقة للإعدادات -->
                <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=btnSettings}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True" Opened="SettingsPopup_Opened">
                    <Border x:Name="SettingsPopupBorder" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,4,0,0" RenderTransformOrigin="0.1,0">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="SettingsScale" ScaleX="1" ScaleY="1"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="4" Opacity="0.2"/>
                        </Border.Effect>
                        <StackPanel Width="210">
                            <TextBlock x:Name="lblSettingsHeader" Text="الإعدادات العامة" Foreground="{DynamicResource MainTextBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>

                            <CheckBox x:Name="chkStartup" Content="تشغيل مع بداية النظام" FontSize="12" Margin="0,0,0,8" Checked="chkStartup_Checked" Unchecked="chkStartup_Unchecked"/>
                            <CheckBox x:Name="chkLockImages" Content="قفل الصور التلقائي" FontSize="12" Margin="0,0,0,8"/>
                            <CheckBox x:Name="chkLockVideos" Content="قفل الفيديوهات التلقائي" FontSize="12" Margin="0,0,0,10"/>

                            <Separator Background="{DynamicResource ButtonBorderBrush}" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,8">
                                <TextBlock x:Name="lblTheme" Text="تغيير اللون:" Foreground="{DynamicResource SubTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <ComboBox x:Name="cmbTheme" HorizontalAlignment="Right" Width="95" FontSize="12" SelectionChanged="cmbTheme_SelectionChanged">
                                    <ComboBoxItem x:Name="cmbItemDark" Content="أسود" IsSelected="True"/>
                                    <ComboBoxItem x:Name="cmbItemLight" Content="أبيض"/>
                                </ComboBox>
                            </Grid>

                            <Grid>
                                <TextBlock x:Name="lblLang" Text="اللغة:" Foreground="{DynamicResource SubTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <ComboBox x:Name="cmbLanguage" HorizontalAlignment="Right" Width="95" FontSize="12" SelectionChanged="cmbLanguage_SelectionChanged">
                                    <ComboBoxItem x:Name="cmbItemArabic" Content="العربية" IsSelected="True"/>
                                    <ComboBoxItem x:Name="cmbItemEnglish" Content="English"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <!-- ============ التبويبات ============ -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="MainTabs_SelectionChanged">
            <TabItem x:Name="tabImages" Header="الـصـور">
                <Grid Margin="0,8,0,0">
                    <ListBox x:Name="ImagesListBox" Style="{StaticResource MediaListBoxStyle}"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="tabVideos" Header="الفيديوهات">
                <Grid Margin="0,8,0,0">
                    <ListBox x:Name="VideosListBox" Style="{StaticResource MediaListBoxStyle}"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="tabTheme" Header="ثـيـم">
                <Grid Margin="0,12,0,0">
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="تغيير ثيم النظام (Windows Accent &amp; Mode)" Foreground="{DynamicResource MainTextBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="قم بتخصيص نمط وألوان النظام والأجواء العامة:" Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="0,0,0,16"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="تطبيق الوضع الداكن (Dark)" Style="{StaticResource HeaderButtonStyle}" Width="160" Height="34" Margin="0,0,8,0" Click="BtnSetDarkTheme_Click"/>
                                <Button Content="تطبيق الوضع الفاتح (Light)" Style="{StaticResource HeaderButtonStyle}" Width="160" Height="34" Click="BtnSetLightTheme_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ تبويب الماوس (قائمة ديناميكية) ============ -->
            <TabItem x:Name="tabCursors" Header="ماوس">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- زر إضافة ثيم ماوس جديد -->
                    <Button Grid.Row="0" Width="140" Height="34" HorizontalAlignment="Right" Margin="0,0,0,10" Style="{StaticResource HeaderButtonStyle}" Click="BtnAddCursorTheme_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource MainTextBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="إضافة ثيم ماوس" Foreground="{DynamicResource MainTextBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- قائمة ثيمات الماوس -->
                    <ListBox Grid.Row="1" x:Name="CursorsListBox" ItemsSource="{Binding CursorsList, RelativeSource={RelativeSource AncestorType=Window}}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12" Width="820">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- الهيدر: مسح، البيانات، والأزرار -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- زر حذف الثيم -->
                                            <Button Grid.Column="0" Content="مسح" Width="60" Height="30" VerticalAlignment="Top" Style="{StaticResource HeaderButtonStyle}" Click="BtnDeleteCursorTheme_Click"/>

                                            <!-- بيانات الثيم -->
                                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ThemeName, StringFormat='اسم الثيم: {0}'}" Foreground="{DynamicResource MainTextBrush}" FontSize="15" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding SizeText, StringFormat='حجمه: {0}'}" Style="{StaticResource CursorInfoText}"/>
                                                <TextBlock Text="{Binding FolderPath, StringFormat='مساره: {0}'}" Style="{StaticResource CursorInfoText}" ToolTip="{Binding FolderPath}"/>
                                            </StackPanel>

                                            <!-- أزرار التحكم -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button Content="تغيير الفولدر" Width="90" Height="30" Margin="0,0,6,0" Style="{StaticResource HeaderButtonStyle}" Click="BtnChangeCursorFolder_Click"/>
                                                <Button Content="تطبيق" Width="70" Height="30" Style="{StaticResource HeaderButtonStyle}" Click="BtnApplyCursorTheme_Click"/>
                                            </StackPanel>
                                        </Grid>

                                        <Separator Grid.Row="1" Margin="0,10" Background="{DynamicResource CardBorderBrush}"/>

                                        <!-- شبكة إيقونات المؤشرات -->
                                        <ItemsControl Grid.Row="2" ItemsSource="{Binding CursorItems}" ItemsPanel="{StaticResource WrapPanelTemplate}" ItemTemplate="{StaticResource CursorItemTemplate}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- ============ الشريط السفلي ============ -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="V1.0" Foreground="{DynamicResource SubTextBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- ============ معاينة كبيرة ============ -->
        <Border x:Name="PreviewPanel" Grid.RowSpan="3" Panel.ZIndex="100" Width="480" Height="270" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource MainTextBrush}" Background="Black" Visibility="Collapsed" IsHitTestVisible="False">
            <Grid FlowDirection="LeftToRight">
                <Grid.Clip>
                    <RectangleGeometry Rect="0,0,478,268" RadiusX="11" RadiusY="11"/>
                </Grid.Clip>
                <Image x:Name="PreviewImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                <MediaElement x:Name="PreviewVideo" LoadedBehavior="Manual" UnloadedBehavior="Manual" IsMuted="True" Volume="0" Stretch="UniformToFill" MediaEnded="PreviewVideo_MediaEnded" MediaFailed="PreviewVideo_MediaFailed"/>
                <Border VerticalAlignment="Bottom" Background="#99000000" Padding="12,7">
                    <TextBlock x:Name="PreviewTitle" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
